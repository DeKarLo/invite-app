<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Приглашение</title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <main class="card">

    <h1>Привет, <%= guest.name %>! 👋</h1>

    <p class="lead">
      Мы с ребятами хотим собраться в антикафе, просто пообщаться, поиграть и хорошо провести время вместе.<br/>
      Это не мероприятие, а просто дружеская встреча нашей компании 😊<br/>
      <br/>
      Скажи, хочешь присоединиться?
    </p>


    <div id="status" class="status">
      <% if (guest.attending === true) { %>
        Отлично, будем рады тебя видеть! 🎉
      <% } else if (guest.attending === false) { %>
        Окей, если что — всегда зови, будем рады! 🙌
      <% } else { %>
        Просто отметь, хочешь ли присоединиться:
      <% } %>
    </div>

    <div class="buttons">
      <button id="btn-yes" class="btn yes" <%= guest.attending !== null ? 'disabled' : '' %>>✅ Да, хочу!</button>
      <button id="btn-no" class="btn no" <%= guest.attending !== null ? 'disabled' : '' %>>❌ Пока не смогу</button>
    </div>
  </main>

  <script>
    (function(){
      const name = encodeURIComponent("<%= guest.name %>")
      const statusEl = document.getElementById('status')
      const yesBtn = document.getElementById('btn-yes')
      const noBtn = document.getElementById('btn-no')

      function lockButtons() {
        yesBtn.disabled = true
        noBtn.disabled = true
      }

      async function send(attending) {
        try {
          const res = await fetch(`/api/respond/${name}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ attending })
          })
          if (!res.ok) {
            const data = await res.json().catch(()=>({}))
            throw new Error(data.error || 'Ошибка отправки ответа')
          }
          const data = await res.json()
          statusEl.innerHTML = data.attending
            ? 'Отлично, будем рады тебя видеть! 🎉'
            : 'Окей, если что — всегда зови, будем рады! 🙌'
          lockButtons()
        } catch (e) {
          alert(e.message || 'Ошибка сети')
        }
      }

      if (yesBtn) yesBtn.addEventListener('click', () => send(true))
      if (noBtn) noBtn.addEventListener('click', () => send(false))
    })();
  </script>
</body>
</html>
